# MySQL connection string.
# - Development (Docker, port host 3307): sesuaikan dengan docker-compose.yml
# - Production (Hostinger): dapatkan di hPanel > Databases > Management
#   Format: mysql://[user]:[password]@[host]:3306/[database]
#   Tambahkan ?connection_limit=20 bila limit koneksi shared hosting ketat.
DATABASE_URL="mysql://barokah:barokah@localhost:3307/barokah"

JWT_SECRET="change-me-to-a-long-random-string"
OWNER_USER="owner"
OWNER_PASS="owner123"
ADMIN_USER="admin"
ADMIN_PASS="admin123"
ADMIN2_USER="admin2"
ADMIN2_PASS="admin2123"
CREW_USER="crew"
CREW_PASS="crew123"
