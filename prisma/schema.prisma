generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  CREW
}

enum EventStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  // true = password dipilih manual oleh admin/crew, jadi tidak bisa lagi
  // dihitung dari username. Dipakai supaya panel kredensial tidak menampilkan
  // pola username+1123 yang sudah tidak berlaku.
  customPassword Boolean  @default(false)
  name         String?
  phone        String?
  photoUrl     String?  @db.VarChar(500)
  role         Role     @default(CREW)
  createdAt    DateTime @default(now())

  scannedLogs      ScanLog[]
  activities       ActivityLog[]
  scannedBySlots   Participant[] @relation("ScannedBy")
  workers          BusWorker[]
}

model Event {
  id        String      @id @default(cuid())
  title     String      @db.VarChar(500)
  date      DateTime
  location  String      @default("") @db.VarChar(500)
  status    EventStatus @default(ACTIVE)
  note      String?     @db.Text
  imageUrl  String?     @db.VarChar(500)
  crewPrefix String?
  // MySQL: Prisma memetakan String ke VARCHAR(191). Konten panduan & layout
  // kursi jauh lebih panjang dari itu, jadi pakai TEXT supaya tidak error
  // "Data too long for column".
  panduanItinerary String? @db.LongText
  panduanRules      String? @db.LongText
  crewName   String?    @db.VarChar(500)
  crewPhone  String?
  crewPhotoUrl String?  @db.VarChar(500)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  buses        Bus[]
  participants Participant[]
  activities   ActivityLog[]

  @@index([date])
}

// Paket event wisata yang ditampilkan di halaman publik /paket.
// Dikelola manual lewat panel admin, tidak terkait dengan model Event.
model PaketEvent {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(500)
  location    String   @default("") @db.VarChar(500)
  description String?  @db.Text
  subtitle    String?  @db.VarChar(500)
  body        String?  @db.Text
  badge       String?  @db.VarChar(100)
  imageUrl    String?  @db.VarChar(500)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices PaketPrice[]
  images PaketImage[]

  @@index([order])
}

model PaketImage {
  id        String   @id @default(cuid())
  paketId   String
  url       String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  paket     PaketEvent @relation(fields: [paketId], references: [id], onDelete: Cascade)

  @@index([paketId, order])
}

model PaketPrice {
  id         String  @id @default(cuid())
  paketId    String
  label      String  @db.VarChar(200)
  price      Int     @default(0)
  facilities Json?
  badge      String? @db.VarChar(100)
  order      Int     @default(0)
  paket      PaketEvent @relation(fields: [paketId], references: [id], onDelete: Cascade)

  @@index([paketId, order])
}

model Bus {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  order     Int      @default(0)
  seatRows  Int      @default(0)
  seatCols  Int      @default(0)
  seatLayout String?  @db.Text
  facilities String?  @db.Text
  createdAt DateTime @default(now())

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants Participant[]
  workers      BusWorker[]

  @@unique([eventId, name])
  @@index([eventId])
}

model BusWorker {
  id        String   @id @default(cuid())
  busId     String
  userId    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  bus Bus @relation(fields: [busId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([busId, userId])
  @@index([busId])
}

model Participant {
  id             String    @id @default(cuid())
  eventId        String
  busId          String
  order          Int
  name           String
  birthPlace     String?
  birthDate      DateTime?
  phone          String?
  seat           String?
  room           String?
  vw             String?
  token          String    @unique @default(cuid())
  ticketCode     String
  scannedAt      DateTime?
  scannedById    String?
  scannedAtEvent DateTime?
  createdAt      DateTime  @default(now())

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bus          Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  scannedBy    User?    @relation("ScannedBy", fields: [scannedById], references: [id], onDelete: SetNull)
  scanLogs     ScanLog[]

  @@index([eventId, busId])
  @@index([eventId, name])
  @@index([scannedAt])
  @@index([ticketCode])
  @@unique([eventId, busId, order])
}

model ScanLog {
  id            String   @id @default(cuid())
  participantId String
  userId        String?
  status        String   @default("attended")
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([participantId])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  eventId   String?
  userId    String?
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([createdAt])
}